package com.example.myapplication;

import android.content.ContentValues;
import android.content.Context;
import android.database.Cursor;
import android.database.sqlite.SQLiteDatabase;
import android.database.sqlite.SQLiteOpenHelper;

public class BookingDatabaseHelper extends SQLiteOpenHelper {

    public BookingDatabaseHelper(Context c) {
        super(c, "Bookings.db", null, 1);
    }

    @Override
    public void onCreate(SQLiteDatabase db) {
        db.execSQL("CREATE TABLE Bookings (" +
                "Booking_ID INTEGER PRIMARY KEY AUTOINCREMENT," +
                "Event_Name TEXT," +
                "Customer_Name TEXT," +
                "Ticket_Quantity TEXT," +
                "Total_Price TEXT)");
    }

    @Override
    public void onUpgrade(SQLiteDatabase db, int oldV, int newV) {
        db.execSQL("DROP TABLE IF EXISTS Bookings");
        onCreate(db);
    }

    // Update existing booking
    public int update(int id, String[] data) {
        ContentValues v = new ContentValues();

        v.put("Event_Name", data[0]);
        v.put("Customer_Name", data[1]);
        v.put("Ticket_Quantity", data[2]);
        v.put("Total_Price", data[3]);

        return getWritableDatabase().update(
                "Bookings", v, "Booking_ID=?",
                new String[]{String.valueOf(id)});
    }

    // Read all bookings
    public Cursor getAll() {
        return getReadableDatabase().rawQuery(
                "SELECT * FROM Bookings", null);
    }
}

MainActivity.java

package com.example.myapplication;

import android.os.Bundle;
import android.database.Cursor;
import android.widget.*;
import androidx.appcompat.app.AppCompatActivity;

public class MainActivity extends AppCompatActivity {

    EditText id, event, name, quantity, price;
    BookingDatabaseHelper db;
    TextView result;

    @Override
    protected void onCreate(Bundle b) {
        super.onCreate(b);
        setContentView(R.layout.activity_main);

        id = findViewById(R.id.etId);
        event = findViewById(R.id.etEvent);
        name = findViewById(R.id.etName);
        quantity = findViewById(R.id.etQuantity);
        price = findViewById(R.id.etPrice);
        result = findViewById(R.id.txtResult);

        db = new BookingDatabaseHelper(this);

        // UPDATE BOOKING
        findViewById(R.id.btnUpdate).setOnClickListener(v -> {
            if (id.getText().toString().trim().isEmpty()) {
                id.setError("Enter Booking ID");
                return;
            }

            int rows = db.update(
                    Integer.parseInt(id.getText().toString()),
                    new String[]{
                            event.getText().toString(),
                            name.getText().toString(),
                            quantity.getText().toString(),
                            price.getText().toString()
                    });

            if (rows > 0) {
                Toast.makeText(this, "Booking Updated",
                        Toast.LENGTH_SHORT).show();
            } else {
                Toast.makeText(this, "Booking ID Not Found",
                        Toast.LENGTH_SHORT).show();
            }
        });

        // VIEW BOOKINGS
        findViewById(R.id.btnView).setOnClickListener(v -> {
            Cursor c = db.getAll();
            StringBuilder s = new StringBuilder();

            while (c.moveToNext()) {
                for (int i = 0; i < c.getColumnCount(); i++) {
                    s.append(c.getColumnName(i))
                     .append(": ")
                     .append(c.getString(i))
                     .append("\n");
                }
                s.append("\n");
            }

            c.close();

            if (s.length() == 0) {
                result.setText("No bookings found");
            } else {
                result.setText(s.toString());
            }
        });
    }
}
